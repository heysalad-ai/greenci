{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "67a17ada4efeee4480283035cc0c5f90",
  "name": "greenci-web-public",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": { "APP_ENV": "dev", "PUBLIC_BETA_FRONTEND": "false" },
  "env": {
    "dev": {
      "name": "greenci-web-public-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "app.greenci.dev", "custom_domain": true }],
      "vars": { "APP_ENV": "dev", "PUBLIC_BETA_FRONTEND": "true" },
      "services": [
        { "binding": "API", "service": "greenci-api-dev" },
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "greenci-web-public-dev",
        },
      ],
    },
  },
}
