{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "greenci-device-gateway-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "send_metrics": false,
  "account_id": "67a17ada4efeee4480283035cc0c5f90",
  "env": {
    "dev": {
      "name": "greenci-device-gateway-dev",
      "workers_dev": true,
      "preview_urls": false,
      "services": [
        { "binding": "DEVICE_SERVICE", "service": "greenci-device-relay-dev" },
      ],
    },
  },
}
